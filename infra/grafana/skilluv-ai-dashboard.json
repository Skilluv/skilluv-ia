{
  "dashboard": {
    "title": "skilluv-ai",
    "description": "Monitoring du service IA Skilluv - challenges, plagiat, matching, media",
    "tags": ["skilluv", "ai", "workers"],
    "timezone": "utc",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "title": "Jobs par minute",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(skilluv_ai_jobs_total[1m])",
            "legendFormat": "{{job_type}} - {{status}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "title": "Jobs en cours",
        "type": "gauge",
        "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "skilluv_ai_jobs_in_progress",
            "legendFormat": "{{job_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 5 },
                { "color": "red", "value": 10 }
              ]
            }
          }
        }
      },
      {
        "title": "Total jobs (24h)",
        "type": "stat",
        "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
        "targets": [
          {
            "expr": "increase(skilluv_ai_jobs_total[24h])",
            "legendFormat": "{{job_type}}"
          }
        ]
      },
      {
        "title": "Duree moyenne de traitement",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "rate(skilluv_ai_jobs_duration_seconds_sum[5m]) / rate(skilluv_ai_jobs_duration_seconds_count[5m])",
            "legendFormat": "{{job_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "title": "P95 duree de traitement",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(skilluv_ai_jobs_duration_seconds_bucket[5m]))",
            "legendFormat": "p95 {{job_type}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s"
          }
        }
      },
      {
        "title": "Taux d'erreur",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "rate(skilluv_ai_jobs_total{status=\"failed\"}[5m]) / rate(skilluv_ai_jobs_total[5m]) * 100",
            "legendFormat": "{{job_type}} error %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 5 },
                { "color": "red", "value": 20 }
              ]
            }
          }
        }
      },
      {
        "title": "Erreurs services externes",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "rate(skilluv_ai_external_errors_total[5m])",
            "legendFormat": "{{service}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops"
          }
        }
      },
      {
        "title": "Distribution des durees (heatmap)",
        "type": "heatmap",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
        "targets": [
          {
            "expr": "rate(skilluv_ai_jobs_duration_seconds_bucket[5m])",
            "legendFormat": "{{le}}"
          }
        ]
      }
    ]
  }
}
