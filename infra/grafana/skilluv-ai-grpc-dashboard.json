{
  "dashboard": {
    "title": "skilluv-ai gRPC (v2 MVP)",
    "description": "Monitoring des 4 services v2 : CodeReview, Plagiarism, TalentDetection, ChallengeGeneration",
    "tags": ["skilluv", "ai", "grpc", "mvp"],
    "timezone": "utc",
    "refresh": "30s",
    "time": {
      "from": "now-1h",
      "to": "now"
    },
    "panels": [
      {
        "title": "RPS par méthode",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
        "targets": [
          {
            "expr": "rate(skilluv_ai_grpc_requests_total[1m])",
            "legendFormat": "{{method}} {{status}}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "ops" } }
      },
      {
        "title": "Taux d'erreur gRPC (%)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
        "targets": [
          {
            "expr": "100 * sum by (method) (rate(skilluv_ai_grpc_requests_total{status=\"error\"}[5m])) / sum by (method) (rate(skilluv_ai_grpc_requests_total[5m]))",
            "legendFormat": "{{method}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "steps": [
                { "color": "green", "value": 0 },
                { "color": "yellow", "value": 2 },
                { "color": "red", "value": 5 }
              ]
            }
          }
        }
      },
      {
        "title": "Latence p50 par méthode",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 0, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, sum by (le, method) (rate(skilluv_ai_grpc_request_duration_seconds_bucket[5m])))",
            "legendFormat": "p50 {{method}}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "s" } }
      },
      {
        "title": "Latence p95 par méthode",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 8, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, sum by (le, method) (rate(skilluv_ai_grpc_request_duration_seconds_bucket[5m])))",
            "legendFormat": "p95 {{method}}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "s" } }
      },
      {
        "title": "Latence p99 par méthode",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 8, "x": 16, "y": 8 },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, sum by (le, method) (rate(skilluv_ai_grpc_request_duration_seconds_bucket[5m])))",
            "legendFormat": "p99 {{method}}"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "s" } }
      },
      {
        "title": "Erreurs Claude API (rate)",
        "type": "timeseries",
        "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
        "targets": [
          {
            "expr": "rate(skilluv_ai_external_errors_total{service=\"claude_api\"}[5m])",
            "legendFormat": "claude errors/s"
          }
        ],
        "fieldConfig": { "defaults": { "unit": "ops" } }
      },
      {
        "title": "Total appels par méthode (24h)",
        "type": "table",
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
        "targets": [
          {
            "expr": "sum by (method, status) (increase(skilluv_ai_grpc_requests_total[24h]))",
            "format": "table",
            "instant": true
          }
        ]
      }
    ]
  }
}
