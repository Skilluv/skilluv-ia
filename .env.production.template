# =========================================================================
# .env.production — TEMPLATE
#
# Ne PAS committer la version remplie. Chiffrer avec sops+age :
#   sops -e --age <age-recipient> .env.production > .env.production.enc
# Voir docs/DEPLOYMENT-HETZNER.md pour la procédure complète.
# =========================================================================

# --- Redis (interne au réseau docker `skilluv`) ---
REDIS_URL=redis://redis:6379/0

# --- MinIO ---
MINIO_ROOT_USER=CHANGE_ME_admin
MINIO_ROOT_PASSWORD=CHANGE_ME_generate_a_long_random_string
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=${MINIO_ROOT_USER}
MINIO_SECRET_KEY=${MINIO_ROOT_PASSWORD}
MINIO_BUCKET=skilluv-media
MINIO_SECURE=false

# --- Claude / Anthropic ---
# API key : console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# Overrides modèles (facultatif — la règle par défaut est MVP.md §0.2)
# SKILLUV_AI_MODEL_REVIEW_CODE=claude-opus-4-7
# SKILLUV_AI_MODEL_ANALYZE_PERFORMANCE=claude-sonnet-4-6
# SKILLUV_AI_MODEL_SUGGEST_CAREER_PATH=claude-haiku-4-5-20251001

# --- gRPC ---
GRPC_PORT=50051

# --- FastAPI (metrics + admin) ---
API_PORT=8000

# --- Environnement ---
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Grafana (utilisé par docker-compose.prod.yml) ---
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_generate_a_long_random_string
GRAFANA_ROOT_URL=https://grafana.skilluv.example.com

# --- Image tag (pin explicite en prod) ---
SKILLUV_AI_IMAGE_TAG=mvp-1
